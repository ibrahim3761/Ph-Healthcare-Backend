<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset Request</title>
    <style>
      body {
        font-family: 'Segoe UI', Arial, sans-serif;
        background: #f0f2f5;
        color: #2d2d2d;
        margin: 0;
        padding: 0;
      }
      .wrapper {
        width: 100%;
        padding: 40px 0;
      }
      .container {
        max-width: 480px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
      }
      .header {
        background: linear-gradient(135deg, #4361ee 0%, #3a0ca3 100%);
        padding: 40px 30px 60px;
        text-align: center;
      }
      .icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #ffffff;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
      }
      .icon svg {
        display: block;
        width: 28px;
        height: 28px;
      }
      .header h1 {
        color: #ffffff;
        font-size: 22px;
        margin: 16px 0 0;
        font-weight: 600;
      }
      .body-content {
        padding: 40px 32px 30px;
        text-align: center;
      }
      .body-content p {
        font-size: 15px;
        line-height: 1.6;
        color: #4a4a4a;
        margin: 12px 0;
      }
      .body-content .name {
        font-weight: 600;
        color: #4361ee;
      }
      .otp-label {
        font-size: 12px;
        font-weight: 600;
        color: #999;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 26px;
      }
      .otp {
        display: inline-block;
        padding: 16px 32px;
        background: #f0f2ff;
        color: #4361ee;
        font-size: 32px;
        font-weight: 700;
        letter-spacing: 10px;
        border-radius: 10px;
        margin-top: 10px;
        border: 1.5px dashed #b3bcf5;
      }
      .expiry {
        display: inline-block;
        margin-top: 16px;
        font-size: 13px;
        color: #d9480f;
        background: #fff4e6;
        padding: 6px 14px;
        border-radius: 20px;
        font-weight: 600;
      }
      .divider {
        height: 1px;
        background: #eee;
        margin: 26px 0 20px;
      }
      .note {
        font-size: 13px;
        color: #888;
        text-align: left;
      }
      .footer {
        text-align: center;
        padding: 24px 20px 30px;
        font-size: 12px;
        color: #999;
      }
      .footer strong {
        color: #666;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="container">
        <div class="header">
          <div class="icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="5" y="11" width="14" height="10" rx="2" fill="#4361ee"/>
              <path d="M8 11V7a4 4 0 0 1 8 0v4" stroke="#4361ee" stroke-width="2" stroke-linecap="round" fill="none"/>
              <circle cx="12" cy="15.5" r="1.5" fill="#ffffff"/>
              <rect x="11.25" y="16" width="1.5" height="2.5" rx="0.75" fill="#ffffff"/>
            </svg>
          </div>
          <h1>Password Reset Request</h1>
        </div>
        <div class="body-content">
          <p>Hello <span class="name"><%= name %></span>,</p>
          <p>We received a request to reset your password. Use the OTP below to continue:</p>

          <div class="otp-label">One-Time Password</div>
          <div class="otp"><%= otp %></div>
          <br />
          <span class="expiry">Expires in <%= expirationMinutes %> minutes</span>

          <div class="divider"></div>

          <p class="note">If you did not request a password reset, you can safely ignore this email — your account remains secure.</p>
        </div>
        <div class="footer">
          &copy; <strong>PH Healthcare System</strong>. All rights reserved.
        </div>
      </div>
    </div>
  </body>
</html>